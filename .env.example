# .env.example - Environment Variables for KittyPau Project

# AWS IoT Core Configuration (for Backend IoT Bridge)
# These are typically paths to certificate files for local development or testing.
# In production, consider storing certificate content directly in environment variables
# or using a secrets manager.
AWS_IOT_ENDPOINT="YOUR_AWS_IOT_ENDPOINT-ats.iot.YOUR_AWS_REGION.amazonaws.com"
AWS_REGION="YOUR_AWS_REGION" # e.g., us-east-1
AWS_IOT_PRIVATE_KEY_PATH="./certs/private.pem.key" # Path to your private key file
AWS_IOT_CERT_PATH="./certs/device.pem.crt"      # Path to your device certificate file
AWS_IOT_ROOT_CA_PATH="./certs/root-CA.pem"        # Path to Amazon Root CA certificate

# Alternatively, for production, you might directly embed content if the deployment method allows:
# AWS_IOT_PRIVATE_KEY_CONTENT="-----BEGIN RSA PRIVATE KEY-----\n..."
# AWS_IOT_CERT_CONTENT="-----BEGIN CERTIFICATE-----\n..."
# AWS_IOT_ROOT_CA_CONTENT="-----BEGIN CERTIFICATE-----\n..."


# PostgreSQL Database Configuration (Neon - for Backend IoT Bridge)
DATABASE_URL="postgresql://[user]:[password]@[neon_hostname]/[db_name]?sslmode=require"

# Backend IoT Bridge Specific Configuration
PORT=3000 # Port for the Node.js server (e.g., for HTTP API and WebSockets)
MQTT_CLIENT_ID="kittypau-iot-bridge-1" # Unique client ID for the bridge
MQTT_SUBSCRIBE_TOPIC="kittypau/+/data/sensors" # Topic pattern for sensor data
JWT_SECRET="YOUR_VERY_STRONG_AND_RANDOM_SECRET_KEY" # Secret for JWT tokens
NEON_AUTH_URL="https://<your-backend-endpoint>.neonauth.<region>.aws.neon.tech/<db>/auth" # Neon Auth URL for backend communication

# Frontend Configuration (Vite/React)
# These should be prefixed with VITE_ to be exposed to the browser by Vite
VITE_API_URL="http://localhost:3000/api" # Base URL for HTTP API calls from frontend
VITE_WS_URL="ws://localhost:3000/ws"     # Base URL for WebSocket connections from frontend
VITE_NEON_AUTH_URL="https://<your-endpoint>.neonauth.<region>.aws.neon.tech/<db>/auth" # Found in your Neon project settings
# In production, these would point to your deployed EC2 instance:
# VITE_API_URL="https://your-ec2-instance-domain/api"
# VITE_WS_URL="wss://your-ec2-instance-domain/ws"
